{
  "name": "grok-bot-helper",
  "productName": "Grok Bot Helper",
  "author": "Grok Bot Helper contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cremess/grok-bot-helper.git"
  },
  "version": "0.3.0",
  "private": true,
  "description": "Unofficial Windows companion for Grok Bot: a global shortcut opens a floating prompt that talks to your bots.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "check": "node scripts/check-syntax.js",
    "icons": "electron scripts/build-icons.js",
    "dist": "electron-builder --win nsis --x64"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "app.grokbothelper.desktop",
    "productName": "Grok Bot Helper",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/icons/**/*",
      "package.json"
    ],
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "cremess",
        "repo": "grok-bot-helper",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": false,
      "shortcutName": "Grok Bot Helper",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Grok-Bot-Helper-Setup-${version}.exe"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.12"
  }
}
